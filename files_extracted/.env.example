# Copy to `.env` (never commit it). Every variable is read in app/config.py.

# ── Required in production ────────────────────────────────────

# JWT signing key. Must be a long random value that only the server knows:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If it is empty the server uses a temporary key and logs everyone out on restart.
SECRET_KEY=

# Google Gemini key for the tutor (/api/chat). Empty = the tutor answers "not enabled".
GOOGLE_API_KEY=

# Database. SQLite for local work; in production the PostgreSQL URL of the host
# (postgres:// and postgresql:// are accepted and switched to the asyncpg driver).
DATABASE_URL=sqlite+aiosqlite:///./arabic_platform.db

# بريد الأستاذ (أو عدة بريدات مفصولة بفواصل) — وحده يرى قائمة الطلاب وتقدمهم
# هذه العناوين لا تُسجَّل من صفحة التسجيل العامة؛ يُنشأ حساب الأستاذ من الخادم:
#   python -m tools.teacher_accounts create --email <البريد> --name "<الاسم>"
TEACHER_EMAILS=teacher@karabuk.edu.tr

# ── Optional (the values shown are the defaults) ──────────────

# Sites allowed to call the API from a browser, comma-separated.
# CORS_ORIGINS=https://arabic-platform-flame.vercel.app,http://localhost:5173

# GEMINI_MODEL=gemini-3.5-flash-lite
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Fill a completely empty database with the base content at start-up.
# It never deletes anything; set to false to seed only by hand (python -m tools.seed).
# SEED_ON_EMPTY_DB=true

# Set to "production" to refuse to start without a real SECRET_KEY.
# ENVIRONMENT=production

# Header that carries the caller's real address when the server sits behind a
# proxy (Railway). Used by the login, password-recovery and tutor limits. Name
# only a header the proxy itself sets; a list keeps its last entry. Empty = the
# connection address, which behind a proxy is the proxy for every request.
# CLIENT_IP_HEADER=x-forwarded-for

# Public URL of the separate grade site; used by the learning platform's link.
# TRACKING_SITE_URL=https://your-grade-site.example.com

# Optional password recovery mail (disabled until configured). TLS is required.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Arabiq Akademi <no-reply@example.com>
# PASSWORD_RESET_URL=https://arabic-platform-flame.vercel.app/#/reset-password
