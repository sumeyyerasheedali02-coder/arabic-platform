# JWT signing key. Must be a long random value that only the server knows:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If it is left empty the server uses a temporary key and logs everyone out on restart.
SECRET_KEY=
GOOGLE_API_KEY=your-gemini-api-key-here
DATABASE_URL=sqlite+aiosqlite:///./arabic_platform.db
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# بريد الأستاذ (أو عدة بريدات مفصولة بفواصل) — وحده يرى قائمة الطلاب وتقدمهم
TEACHER_EMAILS=teacher@karabuk.edu.tr
