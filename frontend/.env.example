# Production builds: the public address of the backend (no trailing slash, no /api).
# Set this in the hosting dashboard (Vercel → Settings → Environment Variables).
VITE_API_URL=https://your-backend.example.com

# Development only: where `npm run dev` forwards /api when VITE_API_URL is not set.
# VITE_DEV_API_TARGET=http://localhost:8000
